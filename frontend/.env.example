# Frontend Environment Variables
# Copy this file to .env.local for local development

# Backend API URL (used for rewrites and API calls)
# Defaults to http://127.0.0.1:5000
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Note: In Docker, this is set at runtime via docker run -e, so .env files will not exist in the containers runtime environment.
