{
  "name": "SabioDocs-frontend",
  "version": "1.0.0",
  "description": "Frontend for SabioDocs Document Agent",
  "private": true,
  "dependencies": {
    "next": "14.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "axios": "1.6.0",
    "tailwindcss": "3.3.0",
    "autoprefixer": "10.4.16",
    "postcss": "8.4.31",
    "http-proxy-middleware": "^2.0.6",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "20.8.0",
    "@types/react": "18.2.25",
    "@types/react-dom": "18.2.11",
    "@openapitools/openapi-generator-cli": "2.7.0",
    "eslint": "8.51.0",
    "eslint-config-next": "14.0.0",
    "typescript": "5.2.2"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js",
    "lint": "next lint",
    "generate-api": "openapi-generator-cli generate -i http://localhost:5000/openapi.json -g typescript-fetch -o ./generated",
    "generate-api:win": "scripts/generate-api.bat"
  }
}
