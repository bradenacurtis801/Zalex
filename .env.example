# Environment Configuration
# ==========================================
# This file contains environment variables required for the application to run.
# Copy this file to .env and update the values as needed.
# DO NOT commit the .env file to version control (it's in .gitignore)

# ==========================================
# Docker Configuration
# ==========================================
# Required for Docker build and deployment scripts
DOCKER_USERNAME=your-dockerhub-username
REPOSITORY_NAME=your-repository-name

# Docker volume name or path for data persistence
# Can be a volume name (e.g., "my_volume") or absolute path (e.g., "/path/to/data")
VOLUME_NAME_OR_PATH=your_volume_name_or_path

# ==========================================
# Hugging Face Token
# ==========================================
# Required for downloading and accessing ML models from Hugging Face.
# Get your token from: https://huggingface.co/settings/tokens
# Format: hf_xxxxxxxxxxxxxxxxxxxx
HF_TOKEN=

# ==========================================
# Backend Configuration
# ==========================================
# Environment mode (dev/prod)
# NODE_ENV=dev

# Server configuration
# BACKEND_HOST=127.0.0.1

# Debug mode (0=prod, 1=debug+wait, 2=debug+no-wait)
# DEBUG=0

# CORS allowed origins (comma-separated or JSON array)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log level (optional, defaults to INFO)
# LOG_LEVEL=INFO

# ==========================================
# Frontend Configuration
# ==========================================
# Backend API URL (used for rewrites and API calls)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL Settings
# If DATABASE_URL is not provided, these will be used to construct it
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB_NAME=app_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Alternative: Provide full database URL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/app_db

# ==========================================
# Training Configuration (Optional)
# ==========================================
# Hugging Face token for uploading models (if different from HF_TOKEN)
# HF_UPLOAD_TOKEN=

# ==========================================
# Notes
# ==========================================
# - In Docker, these are set at runtime via docker run -e, so .env files 
#   will not exist in the containers runtime environment.
# - For local development, copy this file to .env and update the values.
# - For production, set these as environment variables in your deployment environment.

