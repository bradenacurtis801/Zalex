erDiagram
    document {
        character varying filename NOT NULL
        bytea file_content NOT NULL
        integer file_size NOT NULL
        character varying mime_type NOT NULL
        USER-DEFINED status NOT NULL
        timestamp without time zone created_at NOT NULL
        timestamp without time zone updated_at NOT NULL
        character varying id PK NOT NULL
        integer user_id PK FK
    }

    documentclassification {
        character varying category NOT NULL
        double precision confidence NOT NULL
        character varying model_version NOT NULL
        timestamp without time zone created_at NOT NULL
        integer id PK NOT NULL
        character varying document_id PK FK NOT NULL
        integer user_id PK FK
    }

    documentfeedback {
        character varying feedback_type NOT NULL
        character varying suggested_category
        character varying comment
        timestamp without time zone created_at NOT NULL
        integer id PK NOT NULL
        character varying document_id PK FK NOT NULL
        integer user_id PK FK
    }

    ocrdata {
        integer page_number NOT NULL
        character varying full_text NOT NULL
        character varying words_data NOT NULL
        character varying lines_data NOT NULL
        double precision confidence_score NOT NULL
        integer total_words NOT NULL
        integer total_lines NOT NULL
        timestamp without time zone created_at NOT NULL
        integer id PK NOT NULL
        character varying document_id PK FK NOT NULL
        integer original_image_width
        integer original_image_height
    }

    pdfcache {
        integer max_pages NOT NULL
        integer total_pages NOT NULL
        character varying pages_data NOT NULL
        timestamp without time zone created_at NOT NULL
        timestamp without time zone expires_at NOT NULL
        integer id PK NOT NULL
        character varying document_id PK FK NOT NULL
    }

    session {
        integer user_id PK FK NOT NULL
        character varying session_token NOT NULL
        boolean is_revoked NOT NULL
        timestamp without time zone expires_at NOT NULL
        timestamp without time zone created_at NOT NULL
        timestamp without time zone last_activity NOT NULL
        integer id PK NOT NULL
    }

    uploadsession {
        character varying client_id PK NOT NULL
        USER-DEFINED status NOT NULL
        integer total_files NOT NULL
        integer processed_files NOT NULL
        character varying current_file
        double precision progress_percent NOT NULL
        character varying error_message
        timestamp without time zone created_at NOT NULL
        timestamp without time zone updated_at NOT NULL
        timestamp without time zone expires_at NOT NULL
        integer id PK NOT NULL
        integer user_id PK FK
    }

    uploadsessionfile {
        character varying filename NOT NULL
        integer file_size NOT NULL
        character varying mime_type NOT NULL
        USER-DEFINED status NOT NULL
        character varying error_message
        timestamp without time zone created_at NOT NULL
        integer id PK NOT NULL
        integer session_id PK FK NOT NULL
        character varying file_hash
        character varying document_id PK FK
    }

    user {
        character varying username NOT NULL
        character varying email NOT NULL
        character varying full_name NOT NULL
        USER-DEFINED user_role NOT NULL
        boolean is_active NOT NULL
        timestamp without time zone created_at NOT NULL
        timestamp without time zone updated_at NOT NULL
        integer id PK NOT NULL
        character varying password_hash NOT NULL
    }

    document ||--o{ user : "user_id"
    documentclassification ||--o{ document : "document_id"
    documentclassification ||--o{ user : "user_id"
    documentfeedback ||--o{ document : "document_id"
    documentfeedback ||--o{ user : "user_id"
    ocrdata ||--o{ document : "document_id"
    pdfcache ||--o{ document : "document_id"
    session ||--o{ user : "user_id"
    uploadsession ||--o{ user : "user_id"
    uploadsessionfile ||--o{ document : "document_id"
    uploadsessionfile ||--o{ uploadsession : "session_id"